{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HTTP Client Pro",
  "version": "0.1.0",
  "identifier": "pro.http-client.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HTTP Client Pro",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Xtreme-Light/HTTP-Client-Pro/releases/latest/download/latest.json",
        "https://cnb.cool/Xtreme-Light/HTTP-Client-Pro/-/releases/download/latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFNkJDOEY2REQxOUU2M0MKUldRODVobmQ5c2hyYmhlNTd3aGZrQkZpeE5vbEJDelFrOWJwKzh0VmlQaUZBenpvZWdZTXJvYXUK"
    }
  }
}
